{
  "name": "canne-intelligente-serveur",
  "version": "2.0.0",
  "description": "Serveur de l'application Canne Proche : API REST (Express + SQLite), console d'administration, page publique de suivi et API des cannes GPS.",
  "main": "server.js",
  "private": true,
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "demo:reset": "node scripts/reinitialiser-base.js",
    "base:vierge": "node scripts/reinitialiser-base.js --vide",
    "simulateur": "node scripts/simulateur.js",
    "test": "node --test --test-concurrency=1 tests/api.test.js"
  },
  "engines": {
    "node": ">=22.13.0"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2"
  }
}
