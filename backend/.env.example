# Configuration du serveur Canne Intelligente.
# Copiez ce fichier en « .env » (même dossier) puis adaptez les valeurs.
# Toutes les variables sont facultatives en développement.

# --- Serveur -----------------------------------------------------------------
PORT=3000
HOST=0.0.0.0
# development | production (en production : JWT_SECRET obligatoire, pas de données de démo)
NODE_ENV=development
# Adresse publique du serveur, utilisée pour fabriquer les liens de partage.
# Pour tester depuis un téléphone sur le même Wi-Fi : http://<IP-du-PC>:3000
URL_PUBLIQUE=http://localhost:3000
# Origines autorisées par CORS (séparées par des virgules). « * » = toutes (développement).
CORS_ORIGINES=*
# Affiche chaque requête API dans la console.
JOURNAL_REQUETES=true

# --- Sécurité ----------------------------------------------------------------
# Secret de signature des jetons de session. Générez-en un long et aléatoire, par exemple :
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=remplacez-moi-par-une-longue-chaine-aleatoire
# Durée de validité d'une session (format jsonwebtoken : 7d, 12h…)
JWT_DUREE=7d

# --- Base de données ---------------------------------------------------------
# Fichier SQLite (créé automatiquement, avec son dossier).
DB_PATH=data/canne.db
# Crée les données de DÉMONSTRATION au premier démarrage si la base est vide.
DONNEES_DEMO=true

# --- Règles métier -----------------------------------------------------------
# Une canne est « en ligne » si elle a communiqué depuis moins de N minutes.
SEUIL_EN_LIGNE_MIN=5
# Alerte « canne inactive » après N minutes sans aucune transmission.
SEUIL_INACTIVITE_MIN=15
# Fréquence de la vérification d'inactivité (secondes).
INTERVALLE_SURVEILLANCE_S=60
# Alerte « batterie faible » sous ce pourcentage.
SEUIL_BATTERIE_FAIBLE=20
# Durée maximale d'un lien de partage (heures).
DUREE_MAX_PARTAGE_H=72

# --- Notifications push (facultatif) -----------------------------------------
# Chemin du fichier JSON du compte de service Firebase (console Firebase >
# Paramètres du projet > Comptes de service > Générer une clé privée).
# Sans cette variable, les notifications sont « simulées » (affichées dans la console).
# FCM_COMPTE_SERVICE=firebase-compte-service.json

# --- SMS (facultatif) -------------------------------------------------------------
# Sans passerelle, les SMS (code « mot de passe oublié », information de la personne
# lors d'une association) sont simulés : écrits dans ce terminal et visibles dans la
# console d'administration (rubrique Journal > SMS).
# SMS_PASSERELLE_URL=https://passerelle.exemple/api/sms   # reçoit POST {to, message, from}
# SMS_PASSERELLE_CLE=
# SMS_EXPEDITEUR=CanneProche

# --- Tests réels avec un téléphone ------------------------------------------------
# Adresse publique HTTPS du serveur (tunnel ou hébergement) : sert aux liens de
# partage et aux liens d'activation. Exemple : https://xxxx.trycloudflare.com
# URL_PUBLIQUE=
# Imprécision GPS maximale (mètres) pour qu'une position déclenche une alerte de zone.
# PRECISION_MAX_ZONE_M=80
# Clé Google Maps (Maps JavaScript API) : fond de carte Google pour la console,
# la page de suivi partagé et l'application mobile. Sans clé : OpenStreetMap.
# Dans la console Google Cloud, restreignez la clé à vos adresses (référents HTTP).
# GOOGLE_MAPS_CLE=
# Premier administrateur créé au démarrage si la base n'en a aucun (base sans démo).
# ADMIN_TELEPHONE=
# ADMIN_MOT_DE_PASSE=
# ADMIN_NOM=Administrateur
